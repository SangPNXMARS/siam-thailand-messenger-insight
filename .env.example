# Facebook System User Access Token — cần quyền pages_messaging, pages_read_engagement,
# pages_show_list, và được cấp quyền truy cập vào tất cả các Page trong BM SIAM Thailand.
META_ACCESS_TOKEN=

# Phiên bản Graph API
GRAPH_API_VERSION=v19.0

# Mật khẩu đăng nhập trang (bảo vệ dữ liệu SĐT khách hàng)
SITE_PASSWORD=

# Chuỗi bí mật để ký session cookie (chuỗi ngẫu nhiên bất kỳ, càng dài càng tốt)
SESSION_SECRET=

# Khoá bí mật để gọi API làm mới dữ liệu thủ công (POST /api/refresh?key=...)
REFRESH_SECRET=
